<?xml version="1.0" encoding="utf-8"?>
<!-- 系统启动帧：圆形渐变底 + 漫画气泡前景。windowSplashScreen 会把整层裁成圆。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFB018ED"
                android:centerColor="#FFF32E9B"
                android:endColor="#FFFDAB1D"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_splash_fg"
        android:gravity="center" />
</layer-list>
