<?xml version="1.0" encoding="utf-8"?>
<!-- 系统启动帧：蓝色渐变圆底 + 新品牌角色（圆形裁切前景）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FF1C4FD8"
                android:centerColor="#FF4E9BEA"
                android:endColor="#FFBFE6FF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_splash_fg"
        android:gravity="center" />
</layer-list>
